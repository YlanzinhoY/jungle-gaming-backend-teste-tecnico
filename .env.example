# Referência dos valores públicos usados pelo `.env` versionado neste desafio.
# Não inclua segredos de produção neste arquivo.
# Sobrescritas opcionais usadas pelo Docker Compose
POSTGRES_DB=wagering
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@jungle.dev
PGADMIN_DEFAULT_PASSWORD=admin-local
KEYCLOAK_DB_PASSWORD=keycloak-local
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local
KEYCLOAK_PORT=8081
LOCALSTACK_PORT=4566
API_PORT=8080
API_2_PORT=8082
API_3_PORT=8083
JAEGER_UI_PORT=16686
OTEL_GRPC_PORT=4317

HTTP_ADDRESS=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=20s
HTTP_SHUTDOWN_TIMEOUT=15s

DATABASE_URL=postgres://postgres:postgres@localhost:5432/wagering?sslmode=disable
DATABASE_MAX_CONNECTIONS=20

OIDC_ISSUER_URL=http://localhost:8081/realms/gaming
# Opcional fora do Compose; no Compose aponta para o backchannel http://keycloak:8080.
OIDC_DISCOVERY_URL=
OIDC_AUDIENCE=wagering-api
OIDC_PROVIDER_CLAIM=provider_id
OIDC_INTERNAL_ROLE=wallet-service
OIDC_STARTUP_TIMEOUT=10s

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# No AWS access key is configured here. The Compose environment creates an IAM
# user with least-privilege SQS permissions and mounts its generated credentials
# only into the API containers. For a standalone process, set both variables.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_INPUT_DLQ=wager-transactions-dlq.fifo
SQS_EVENT_QUEUE=wager-events.fifo
SQS_EVENT_DLQ=wager-events-dlq.fifo
# The broker bootstrap provisions queues, DLQs, redrive and IAM policies before
# APIs start. Keep this false for the restricted application identity.
SQS_CREATE_QUEUES=false
# Required only by the local MiniStack emulator; keep false for AWS SQS.
SQS_DISABLE_MESSAGE_CHECKSUM_VALIDATION=true
SQS_MAX_RECEIVES=5
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_RETRY_BASE_BACKOFF=2s
SQS_RETRY_MAX_BACKOFF=2m
# Only for controlled recovery-test fault injection; keep 0s under normal operation.
SQS_CONSUMER_POST_COMMIT_DELAY=0s

WORKERS_ENABLED=true
SQS_CONSUMER_CONCURRENCY=4
OUTBOX_BATCH_SIZE=50
REFERENCE_BATCH_SIZE=50
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_BASE_BACKOFF=2s
REFERENCE_MAX_BACKOFF=5m
OUTBOX_LEASE=30s
WORKER_POLL_INTERVAL=1s

# OpenTelemetry tracing (OTLP/gRPC)
OTEL_TRACING_ENABLED=true
OTEL_SERVICE_NAME=jungle-gaming-api
OTEL_SERVICE_VERSION=local
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLE_RATIO=1
